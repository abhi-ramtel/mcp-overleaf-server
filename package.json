{
  "name": "mcp-overleaf-server",
  "version": "1.0.0",
  "description": "MCP server that tailors your Overleaf LaTeX resume and cover letter to a job description — pull, render, compile, track — from any MCP client.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-overleaf-server": "dist/index.js"
  },
  "files": [
    "dist",
    "templates/AUTHORING.md",
    "templates/cover-letter-template.tex",
    "templates/resume-template.tex"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\""
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "overleaf",
    "latex",
    "resume",
    "cv",
    "ats",
    "job-search"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^17.4.2",
    "simple-git": "^3.36.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
