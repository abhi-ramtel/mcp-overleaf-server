# ── Overleaf ───────────────────────────────────────────────────────────────
# Overleaf Git authentication token.
# Overleaf → Account Settings → Git Integration → "Generate token".
# Used as the password with username "git" against git.overleaf.com.
OL_GIT_AUTHENTICATION_TOKEN=olp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional default project. Accepts either the full project URL or a bare 24-char id.
# Can always be overridden per tool call.
OVERLEAF_PROJECT_URL=https://www.overleaf.com/project/xxxxxxxxxxxxxxxxxxxxxxxx

# ── Paths (relative paths resolve against the project root) ──────────────────
# Master CV markdown — the single source of truth for all your experience.
CV_MASTER_PATH=./cv.md

# Where generated resumes/CVs and the tracker sheet are written.
CAREER_OUTPUT_DIR=./output

# ── LaTeX ────────────────────────────────────────────────────────────────────
# Engine used to compile .tex → .pdf: latexmk (recommended) | pdflatex | xelatex | lualatex
LATEX_ENGINE=latexmk
